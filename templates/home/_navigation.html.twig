<header class="relative z-10 mx-auto max-w-7xl px-3 pt-3 sm:px-8 sm:pt-5">
    <nav aria-label="Navigation principale" class="flex items-center justify-between rounded-full border border-white/10 bg-white/[0.06] px-4 py-2.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.12),0_12px_40px_rgba(0,0,0,0.18)] backdrop-blur-2xl sm:px-7 sm:py-3">
        {# Affiche le logo et l'identité de marque EventPulse #}
        <a href="{{ path('homepage') }}" class="flex items-center gap-2.5 font-semibold tracking-tight text-white">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-cyan-200/30 bg-gradient-to-tr from-cyan-400/20 via-sky-400/30 to-violet-500/20 text-cyan-200 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)] sm:h-9 sm:w-9">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </span>
            <span class="bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent font-bold text-base sm:text-lg">EventPulse</span>
        </a>

        {# Propose les liens de navigation principaux du site #}
        <div class="hidden items-center gap-8 text-sm font-medium text-slate-300 md:flex">
            <a href="{{ path('homepage') }}" class="transition hover:text-white">Accueil</a>
            <a href="{{ path('app_conference_index') }}" class="transition hover:text-white">Conférences</a>
            {% if app.user and is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_assistant') }}" class="transition hover:text-white flex items-center gap-1.5 text-cyan-300 font-semibold">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                    Assistant IA
                </a>
            {% endif %}
        </div>

        {# Regroupe les boutons d'action rapide et la gestion de session #}
        <div class="flex items-center gap-2 sm:gap-3">
            <a href="{{ path('app_conference_index') }}" class="inline-flex items-center gap-1.5 rounded-full border border-cyan-300/30 bg-cyan-400/10 px-3 py-1.5 text-xs font-semibold text-cyan-200 shadow-[inset_0_1px_0_rgba(255,255,255,0.16)] backdrop-blur-xl transition hover:bg-cyan-400/20 sm:px-4 sm:py-2">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="hidden sm:inline">Consulter les événements</span>
                <span class="sm:hidden">Événements</span>
            </a>

            {# Gère l'accès à l'espace d'administration et la déconnexion si l'utilisateur est authentifié #}
            {% if app.user %}
                <a href="{{ path('admin') }}" class="inline-flex items-center gap-1.5 rounded-full border border-violet-400/30 bg-violet-500/15 px-3 py-1.5 text-xs font-semibold text-violet-200 shadow-[inset_0_1px_0_rgba(255,255,255,0.16)] backdrop-blur-xl transition hover:bg-violet-500/25 sm:px-4 sm:py-2" title="Accéder au panneau d'administration">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Admin</span>
                </a>
                <a href="{{ path('app_logout') }}" class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 p-1.5 text-slate-300 transition hover:border-rose-400/30 hover:bg-rose-500/20 hover:text-rose-200 sm:p-2" title="Se déconnecter">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="sr-only">Déconnexion</span>
                </a>
            {% else %}
                {# Propose le bouton de connexion vers l'espace d'administration pour les visiteurs #}
                <a href="{{ path('app_login') }}" class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.16)] backdrop-blur-xl transition hover:bg-white/20 sm:px-4 sm:py-2">
                    <svg class="h-3.5 w-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    <span>Connexion</span>
                </a>
            {% endif %}
        </div>
    </nav>
</header>
