{% extends 'base.html.twig' %}

{% block title %}Connexion · EventPulse{% endblock %}

{% block body %}
<main class="relative isolate min-h-screen overflow-hidden bg-[#080b16] text-white selection:bg-cyan-300 selection:text-slate-950 pb-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_20%,rgba(56,189,248,0.18),transparent_50%),radial-gradient(ellipse_at_80%_80%,rgba(139,92,246,0.22),transparent_50%),linear-gradient(135deg,#080b16_10%,#111a31_55%,#101020)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 top-40 h-80 w-80 rounded-full bg-cyan-400/20 blur-[100px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 bottom-24 h-80 w-80 rounded-full bg-violet-500/20 blur-[110px]"></div>

    {% include 'home/_navigation.html.twig' %}

    <div class="relative z-10 mx-auto flex min-h-[calc(100vh-140px)] max-w-md items-center justify-center px-4 py-8 sm:px-6">
        <div class="w-full rounded-2xl border border-white/15 bg-white/[0.07] p-6 shadow-2xl backdrop-blur-2xl sm:rounded-3xl sm:p-8">
            <header class="mb-6 text-center sm:mb-8">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl border border-cyan-300/30 bg-gradient-to-tr from-cyan-400/20 via-sky-400/30 to-violet-500/20 text-cyan-200 shadow-[inset_0_1px_0_rgba(255,255,255,0.2)]">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Espace d'administration</h1>
                <p class="mt-1 text-xs text-slate-300 sm:text-sm">Identifiez-vous pour gérer les conférences et modérer les avis.</p>
            </header>

            {% if error %}
                <div class="mb-5 flex items-center gap-3 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-200 sm:text-sm">
                    <svg class="h-5 w-5 shrink-0 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-5 rounded-xl border border-white/10 bg-white/5 p-3.5 text-center text-xs text-slate-300 sm:text-sm">
                    Connecté en tant que <span class="font-semibold text-white">{{ app.user.userIdentifier }}</span>.
                    <a href="{{ path('app_logout') }}" class="ml-2 font-medium text-cyan-300 underline hover:text-cyan-200">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-4 sm:space-y-5">
                <div>
                    <label for="inputUsername" class="mb-1.5 block text-xs font-medium text-slate-200 sm:text-sm">Nom d'utilisateur</label>
                    <input
                        type="text"
                        value="{{ last_username }}"
                        name="username"
                        id="inputUsername"
                        class="w-full rounded-xl border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white placeholder-slate-400 shadow-inner outline-none transition focus:border-cyan-400/60 focus:bg-white/[0.09] focus:ring-2 focus:ring-cyan-400/20 sm:px-4 sm:py-3"
                        autocomplete="username"
                        placeholder="admin"
                        required
                        autofocus
                    >
                </div>

                <div>
                    <label for="inputPassword" class="mb-1.5 block text-xs font-medium text-slate-200 sm:text-sm">Mot de passe</label>
                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        class="w-full rounded-xl border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white placeholder-slate-400 shadow-inner outline-none transition focus:border-cyan-400/60 focus:bg-white/[0.09] focus:ring-2 focus:ring-cyan-400/20 sm:px-4 sm:py-3"
                        autocomplete="current-password"
                        placeholder="••••••••"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button
                    type="submit"
                    class="mt-2 w-full rounded-xl bg-gradient-to-r from-cyan-400 via-sky-500 to-violet-600 px-4 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:opacity-95 hover:shadow-cyan-500/30 focus:outline-none focus:ring-2 focus:ring-cyan-400/40"
                >
                    Se connecter
                </button>
            </form>

            <footer class="mt-6 text-center text-xs text-slate-400">
                <a href="{{ path('homepage') }}" class="transition hover:text-white">← Retour au site public</a>
            </footer>
        </div>
    </div>
</main>
{% endblock %}
